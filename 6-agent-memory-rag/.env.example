# ============================================================================
# 第八章《记忆与检索》示例 —— 环境配置模板
# 用法：复制为 .env，放到运行脚本的同级目录（示例用 load_dotenv() 读当前目录）
# ============================================================================

# ==========================
# LLM 配置（RAGTool / Agent 必需，MemoryTool 不需要）
# 任何 OpenAI 兼容端点都可以；填你本机网关也行
# ==========================
LLM_MODEL_ID=your-model-name
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=http://127.0.0.1:3000/v1
LLM_TIMEOUT=60

# ==========================
# Qdrant 向量数据库（本地 Docker）
# 启动：见 start-databases.sh
# ⚠️ 连 WSL2 里的容器务必用 127.0.0.1，不要用 localhost：
#    WSL2 端口转发只监听 IPv4，localhost 会先解析到 IPv6 的 ::1 并卡满超时。
# 云服务则填 QDRANT_URL=https://xxx.qdrant.tech:6333 + QDRANT_API_KEY
# ==========================
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=hello_agents_vectors
QDRANT_VECTOR_SIZE=384
QDRANT_DISTANCE=cosine
QDRANT_TIMEOUT=30

# ==========================
# Neo4j 图数据库（本地 Docker）
# ⚠️ NEO4J_PASSWORD 必须与容器 NEO4J_AUTH 的密码一致，否则语义记忆初始化会失败
# ⚠️ 连 WSL2 里的容器务必用 127.0.0.1：localhost 会先解析到 IPv6 ::1，
#    表现为 bolt 7687 稳定超时（HTTP 7474 却正常，极易误判为抖动）
# 云服务则填 NEO4J_URI=neo4j+s://xxx.databases.neo4j.io
# ==========================
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=hello-agents-password
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_LIFETIME=3600
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=60

# ==========================
# Embedding 配置
# 框架回退顺序：dashscope -> local -> tfidf（仅初始化时探测一次）
#   dashscope : 需要 EMBED_API_KEY（阿里云百炼），默认模型 text-embedding-v3
#   local     : 需要 torch + sentence-transformers，默认 all-MiniLM-L6-v2
#               （首次运行会从 HuggingFace 下载约 90MB，国内建议 export HF_ENDPOINT=https://hf-mirror.com）
#   tfidf     : ⚠️ 实测不可用！TFIDFEmbedding 必须先 fit()，框架未调用，
#               会导致语义记忆写入/检索全部失败（TF-IDF模型未训练）。仅作冒烟测试
# ==========================
EMBED_MODEL_TYPE=local
# 推荐填本地模型目录（首次从 HF 下载后放到 ./huggingface-models/ 下，离线加载、不占 C 盘）：
# EMBED_MODEL_NAME=<项目根>/6-agent-memory-rag/huggingface-models/all-MiniLM-L6-v2
# 留空则用模型 ID（联网解析，国内需配下面的 HF_ENDPOINT）
EMBED_MODEL_NAME=
EMBED_API_KEY=
EMBED_BASE_URL=

# 仅当需要联网下载模型时才配；若全部使用本地模型目录可不配
HF_ENDPOINT=https://hf-mirror.com

# ==========================
# 可选：多模态编码器（第 09 示例的感知记忆）
# 不配则自动降级为哈希向量，示例仍可跑通，只是不具备跨模态语义检索能力
# 推荐也指向 ./huggingface-models/ 下的本地目录：
# CLIP_MODEL=<项目根>/6-agent-memory-rag/huggingface-models/clip-vit-base-patch32
# CLAP_MODEL=<项目根>/6-agent-memory-rag/huggingface-models/clap-htsat-unfused
# ==========================
# CLIP_MODEL=openai/clip-vit-base-patch32
# CLAP_MODEL=laion/clap-htsat-unfused

# ==========================
# 调试
# ==========================
LOG_LEVEL=INFO
# DEBUG=1
